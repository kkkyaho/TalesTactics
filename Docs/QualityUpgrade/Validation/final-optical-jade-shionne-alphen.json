  "findings": [
    {
      "id": "jade-support-scale",
      "severity": "requires_followup",
      "hero": "jade",
      "scope": "All 8 base/signature captures; Premium row1 compared with HQ/motion/extra rows2-4, especially standing column1.",
      "detail": "The Premium heads, upper bodies and boots read larger/broader than the support frames at the same character scale and camera. The shortness of a thrust or fallen pose does not explain the standing comparison. HQ is consistently smaller; signature motion and extra are also visibly smaller. Polish standing height already matches Premium, so blanket enlargement of all four support sheets is not justified.",
      "recommendedAction": "Review a limited PPU correction of HQ/motion/extra using the provisional table and then recapture actual continuous motion. Do not alter source PNGs or blindly scale Polish. Uniform PPU cannot fully correct a remaining head-to-torso proportion difference."
    },
    {
      "id": "shionne-original-side-pose",
      "severity": "source_inherited_direction_observation",
      "hero": "shionne",
      "scope": "Direction2/3 standing/guard slots, base and signature.",
      "detail": "Some support standing/guard frames face opposite to Premium0 at the same direction number. PixelCampaign-shionne-hq reference row1 column3 already faces left while Premium direction2 faces right; the new HQ candidate faithfully retains the source pose. Therefore this is not a direction introduced by the transition redraw. It may still be noticeable at a runtime join; static inspection does not determine whether a clip intentionally turns for that pose.",

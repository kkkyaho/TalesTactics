  "data": {
    "command": "eval",
    "parameters": {
      "code": "// Read-only catalog inventory for quality review. Run in an open TestBattle scene.\nvar battle=UnityEngine.Object.FindFirstObjectByType<TalesTactics.BattleDirector>();\nvar characters=battle.Catalog.Characters.Concat(battle.Catalog.Enemies).ToArray();\nvar rows=new System.Collections.Generic.List<object>();\nvar issues=new System.Collections.Generic.List<string>();\nforeach(var data in characters)\n{\n    var serialized=new UnityEditor.SerializedObject(data);var property=serialized.GetIterator();\n    var sprites=new System.Collections.Generic.HashSet<UnityEngine.Sprite>();\n    while(property.Next(true))\n    {\n        if(property.propertyType!=UnityEditor.SerializedPropertyType.ObjectReference)continue;\n        if(property.objectReferenceValue is UnityEngine.Sprite sprite)sprites.Add(sprite);\n    }\n    foreach(var sprite in sprites)\n    {\n        var rect=sprite.rect;\n        if(rect.xMin<0||rect.yMin<0||rect.xMax>sprite.texture.width||rect.yMax>sprite.texture.height)issues.Add(data.Id+\": sprite rectangle outside texture: \"+sprite.name);\n        if(sprite.pixelsPerUnit<=0)issues.Add(data.Id+\": invalid PPU: \"+sprite.name);\n    }\n    foreach(TalesTactics.Facing facing in System.Enum.GetValues(typeof(TalesTactics.Facing)))\n        if(data.Sprites.Get(facing)==null)issues.Add(data.Id+\": missing \"+facing);\n    rows.Add(new {id=data.Id,spriteCount=sprites.Count,textures=sprites.Select(s=>UnityEditor.AssetDatabase.GetAssetPath(s.texture)).Distinct().OrderBy(s=>s).ToArray()});\n}\nreturn new {characters=rows,issues=issues,audio=battle.Audio.Library.Entries.Select(e=>new {id=e.Id,clip=e.Clip==null?null:UnityEditor.AssetDatabase.GetAssetPath(e.Clip),seconds=e.Clip==null?0:e.Clip.length}).ToArray()};\n"
    },
